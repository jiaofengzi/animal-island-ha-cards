{
  "name": "animal-island-ha-cards",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "license": "(Apache-2.0 AND MIT)",
  "scripts": {
    "build": "node scripts/build-cards.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts demo playwright.config.ts",
    "test": "node --test tests/core.test.mjs",
    "test:browser": "playwright test",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/build-cards.mjs && node scripts/build-preview.mjs && node scripts/serve.mjs",
    "licenses": "node scripts/licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:island-ui && npm run build",
    "build:showcase": "node scripts/run-legacy.mjs build:showcase",
    "build:acceptance": "node scripts/run-legacy.mjs build:acceptance",
    "build:legacy": "node scripts/run-legacy.mjs build",
    "check:legacy": "node scripts/run-legacy.mjs check",
    "test:island-ui": "node --test tests/island-ui/*.test.mjs",
    "typecheck:cards": "tsc -p tsconfig.cards.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "animal-island-ui": "^3.0.0",
    "classnames": "^2.5.1",
    "naive-icons": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mdi/js": "^7.4.47",
    "color-name": "^2.1.0",
    "culori": "^4.0.1",
    "hammerjs": "^2.0.8",
    "home-assistant-js-websocket": "^9.6.0",
    "intl-messageformat": "^11.2.4",
    "js-yaml": "^4.1.1",
    "lit": "^3.3.2",
    "memoize-one": "^6.0.0",
    "object-hash": "^3.0.0",
    "sortablejs": "^1.15.7",
    "superstruct": "^2.0.2"
  }
}
