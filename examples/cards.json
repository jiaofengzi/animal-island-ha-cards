          "running"
        ],
        "service": "button.press",
        "entity": "button.demo_laundry_pause"
      },
      {
        "label": "继续洗衣",
        "role": "primary",
        "when_states": [
          "已暂停"
        ],
        "service": "button.press",
        "entity": "button.demo_laundry_resume"
